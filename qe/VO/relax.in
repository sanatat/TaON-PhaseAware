&CONTROL
    calculation = 'relax',
    restart_mode = 'from_scratch',
    outdir = '${PROJECT_ROOT}/dft/runs/VO23_relax_lowmem/tmp',
    prefix = 'taon_vo23_relax',
    disk_io = 'high',
   pseudo_dir       = '${PROJECT_ROOT}/dft/pseudo'
    max_seconds = 2400,
    nstep = 25,
    etot_conv_thr = 1.0d-5,
    forc_conv_thr = 1.0d-3,
    tprnfor = .true.,
/
&SYSTEM
   ecutwfc          = 78
   ecutrho          = 624
   occupations      = 'smearing'
   degauss          = 0.005
   smearing         = 'gaussian'
   nspin            = 2
   ntyp             = 3
   nat              = 23
   ibrav            = 0
    starting_magnetization(1) = 0.05,
    starting_magnetization(2) = 0.0,
    starting_magnetization(3) = 0.0,
/
&ELECTRONS
    electron_maxstep = 70,
   conv_thr         = 1e-06
    mixing_beta = 0.2,
    mixing_ndim = 3,
   diagonalization  = 'cg'
/
&IONS

    ion_dynamics = 'bfgs',
/
&CELL
/
&FCP
/
&RISM
/
